<Window x:Class="UiProbeDemo.DashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="后台探针仪表盘" Height="820" Width="1180"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2F2F44"/>
            <Setter Property="Foreground" Value="#EAEAF2"/>
            <Setter Property="BorderBrush" Value="#4A4A68"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#2A2A3C" CornerRadius="4" Padding="8,4" Margin="12,6,12,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="探针事件流:" Foreground="#F7C948" FontSize="12" VerticalAlignment="Top" Margin="0,2,8,0"/>
                <TextBox x:Name="LogDash" Background="#12121C" Foreground="#D8D8E0" FontFamily="Consolas" FontSize="11.5"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" Height="96" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <TabControl Background="Transparent" BorderThickness="0">

            <TabItem Header="① 资源斜率(句柄/内存/线程)" Foreground="#EAEAF2">
                <DockPanel Margin="12,8,12,4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnSample" Content="开始/停止采样(500ms)" Click="BtnSample_Click"/>
                        <Button Content="制造句柄泄漏(开 60 个文件句柄)" Click="BtnLeakHandle_Click"/>
                        <Button Content="制造内存膨胀(挂 30MB)" Click="BtnLeakMem_Click"/>
                        <Button Content="全部释放" Click="BtnRelease_Click" Background="#5A2A2A"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,4">
                        <TextBlock x:Name="ValMem" Foreground="#5B9BD5" FontSize="13" Margin="0,0,24,0" Text="内存 -"/>
                        <TextBlock x:Name="ValHnd" Foreground="#F7B267" FontSize="13" Margin="0,0,24,0" Text="句柄 -"/>
                        <TextBlock x:Name="ValThr" Foreground="#70DB94" FontSize="13" Margin="0,0,24,0" Text="线程 -"/>
                        <TextBlock x:Name="ValGc"  Foreground="#B8B8C8" FontSize="13" Text="GC -"/>
                    </StackPanel>
                    <Border Background="#12121C" CornerRadius="4" Padding="4">
                        <Canvas x:Name="ChartRes" Width="880" Height="440"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="② 状态机走线" Foreground="#EAEAF2">
                <DockPanel Margin="12,8,12,4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnSmRun" Content="开始走线" Click="BtnSmRun_Click"/>
                        <Button Content="注入野事件(乱序回调)" Click="BtnSmIllegal_Click"/>
                        <TextBlock Foreground="#8F8FA8" FontSize="12" VerticalAlignment="Center"
                                   Text="  绿闪=合法迁移被点亮;红虚线=野事件被逮住(不走线)"/>
                    </StackPanel>
                    <Border Background="#12121C" CornerRadius="4" Padding="4">
                        <Canvas x:Name="ChartSm" Width="880" Height="470"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="③ Modbus 对帧分解" Foreground="#EAEAF2">
                <DockPanel Margin="12,8,12,4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnMbRun" Content="开始收流" Click="BtnMbRun_Click"/>
                        <TextBlock Foreground="#8F8FA8" FontSize="12" VerticalAlignment="Center"
                                   Text="  每 350ms 一帧,约 1/3 概率坏帧;行=帧,红色段=定罪字段"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#12121C" CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="当前帧分解" FontSize="12" Foreground="#8F8FA8" Margin="0,0,0,4"/>
                            <StackPanel x:Name="FrameSegs" Orientation="Horizontal"/>
                            <TextBlock x:Name="TxtError" Text="" Foreground="#FF6B6B" FontSize="12.5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#12121C" CornerRadius="4" Padding="4">
                        <Canvas x:Name="ChartMb" Width="880" Height="360"/>
                    </Border>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
